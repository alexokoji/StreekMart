# @prisma/adapter-libsql@5.4.3 declares @libsql/client@^0.3.5 as a peer, but
# Turso requires the modern @libsql/client (^0.17). The adapter still works
# against the newer client — its peer range is just out of date. This flag
# tells npm to install the lockfile we resolved with --legacy-peer-deps so
# CI / Render / Fly / Cloud Run builds all succeed without manual flags.
#
# Removable once we bump to Prisma 6 + @prisma/adapter-libsql@^6 (its peer
# range covers @libsql/client@^0.14).
legacy-peer-deps=true
