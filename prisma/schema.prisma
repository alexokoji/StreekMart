// UpClo â€” fashion marketplace data model
// SQLite for local dev; swap provider to "postgresql" for production.
// SQLite has no native enums; status fields are stored as strings. Type safety
// is provided by `src/lib/enums.ts`.

generator client {
  provider = "prisma-client-js"
  // Driver adapters are GA in Prisma 6, no preview flag needed. Turso
  // connectivity in production goes through @prisma/adapter-libsql â€”
  // see src/lib/db.ts. The datasource below stays "sqlite" so local dev
  // with a dev.db file is unchanged.
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// -------------------- Users & Auth --------------------
// Every account is implicitly a BUYER. Users opt-in to additional permissions:
// `isSeller` (can list products) and/or `isDesigner` (can publish posts + use
// sketch studio). Both can be true simultaneously.

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  // Nullable â€” Google OAuth accounts have no password. At least one of
  // (passwordHash, googleId) is expected to be set; the login endpoints
  // enforce that on their respective paths.
  passwordHash String?
  // Google OAuth subject ID. Unique so a single Google identity can only
  // claim one UpClo account. Linked at OAuth callback time.
  googleId     String?  @unique
  // Which provider minted the account: "password" or "google".
  authProvider String   @default("password")
  name         String
  // Business / brand name shown to buyers on product cards, the public
  // profile, and order receipts. Required for sellers (enforced in the
  // UI + API; legacy rows allowed to be null until the user fills it in).
  // Stored case-as-typed. `businessNameLower` is a normalised mirror that
  // carries the @unique constraint â€” SQLite has no case-insensitive
  // collation, so we compare on lowercase ourselves.
  // Once set, the user can't edit it directly â€” they submit a
  // BusinessNameChangeRequest for admin approval.
  businessName       String?
  businessNameLower  String?  @unique
  // Required for everyone â€” used for delivery contact and order updates.
  // Nullable for legacy rows; the dashboard nags users to fill it in.
  phone              String?
  // Optional banner shown on the public profile page (/u/<slug>). Only the
  // profile owner can upload one. Falls back to the gradient hero when null.
  coverImageUrl      String?
  // URL-friendly handle for the public profile (/u/<slug>). Auto-generated
  // from `name` at signup; users can change it from Account settings.
  // Nullable for legacy rows; backfilled by the seed and the slug helper.
  slug         String?  @unique
  isSeller     Boolean  @default(false)
  isDesigner   Boolean  @default(false)
  // Verification flags â€” only verified sellers/designers get a badge in UI.
  // Kept as the canonical "admin has approved them" gate. The tier columns
  // below derive presentation from this plus profile completeness.
  sellerVerified   Boolean @default(false)
  designerVerified Boolean @default(false)
  // Tiered badge state.
  //   1 = Unverified (default).
  //   2 = Blue check. Admin has approved verification AND the relevant
  //       profile data is in place (sellers also need a default PICKUP
  //       address â€” recompute lives in src/lib/tiers.ts).
  //   3 = Gold check. Admin-granted only; sticky once awarded. Incentive /
  //       criteria TBD â€” for now treat as an explicit override.
  sellerTier       Int     @default(1)
  designerTier     Int     @default(1)
  // Audit for verification decisions â€” set when an admin approves the request.
  verifiedAt   DateTime?
  verifiedBy   String?
  // Seller rating rollup. Source of truth is the SellerReview table;
  // these two columns are recomputed on every review create/update/delete
  // so listing rails and the rank algorithm can read them without an
  // aggregation query per product.
  sellerRatingAvg   Float @default(0)
  sellerRatingCount Int   @default(0)
  // Platform admin flag â€” gates /admin and the /api/admin/* endpoints.
  isAdmin      Boolean  @default(false)
  // Staff = a user with a scoped subset of admin permissions. A super-admin
  // (`isAdmin: true`) implicitly has every permission; staff have only the
  // ones listed in `staffPermissionsJson`. Both flags can be true (rare â€”
  // a staffer promoted to admin keeps their perm list for audit/history).
  isStaff      Boolean  @default(false)
  // JSON array of permission strings (see src/lib/staffPermissions.ts for
  // the canonical list). Empty array means the staff member can sign in
  // but can't do anything until an admin grants them perms.
  staffPermissionsJson String @default("[]")
  // Soft-suspension. When set, the account can't sign in, all sessions are
  // invalidated at the next request (auth gate checks this column), and
  // their products/posts are hidden from the storefront. Reversible â€” an
  // admin clears the field to reinstate. A hard removal is a separate
  // path that uses Prisma's onDelete:Cascade on User to wipe everything.
  suspendedAt      DateTime?
  suspendedBy      String?
  suspensionReason String?
  // Presence heartbeat â€” bumped by requireApiUser when stale (>30s old).
  // The chat polling endpoint reads this to surface "online" / "offline"
  // for the peer. We deliberately don't show a "last seen X minutes ago"
  // anywhere â€” only the live online flag, derived as `now - lastSeenAt < 90s`.
  lastSeenAt   DateTime?
  // Email verification. NULL until the user clicks the link in the
  // verification email; set to the timestamp of the successful click.
  // Google sign-ups land verified because Google has already vetted the
  // address, but we still send them a confirmation email for parity.
  // The token + expiry are wiped on successful verification so a stale
  // link can't be replayed.
  emailVerifiedAt                  DateTime?
  emailVerificationToken           String?   @unique
  emailVerificationTokenExpiresAt  DateTime?
  // Password reset -- single active token at a time. Set on /api/auth/forgot-password,
  // consumed (and cleared) on /api/auth/reset-password. Tokens expire after 60min.
  passwordResetToken               String?   @unique
  passwordResetTokenExpiresAt      DateTime?
  // Trusted-buyer flag â€” set by an admin once a buyer has completed enough
  // delivery-confirmed orders. Required to use Pay-on-Delivery at checkout.
  trustedBuyer Boolean  @default(false)
  // StreekMart-affiliated seller flag â€” set manually by an admin. When
  // true, the seller bypasses escrow (payment lands as withdrawable
  // immediately on paid order, not held until delivery), gets a branded
  // badge, and is allowed to set their own delivery fees. Lib/orders.ts
  // reads this when crediting the wallet; admin UI in /admin/users toggles.
  streekmartAffiliated Boolean @default(false)
  // Location â€” collected at registration so buyers can be matched with
  // nearby sellers and sellers know where they're shipping. ISO-3166 alpha-2
  // for `country`. Nullable on legacy rows; the UI prompts users to fill in.
  country      String?
  region       String?
  city         String?
  // Seller delivery rates (cents). Apply when this user is the seller on an
  // order. Buyers don't write to these â€” they're seller-side shop config.
  // Stored in USD-cents like every other money field on the platform.
  deliveryWithinCityCents      Int @default(0)
  deliveryOutsideCityCents     Int @default(0)
  deliveryOutsideCountryCents  Int @default(0)
  bio          String?
  avatarUrl    String?
  // Buyer preferences captured at signup or in account settings. Used by
  // the recommendations + smart-search ranker to bias picks toward the
  // shopper's stated taste. `interestsJson` is a JSON array of category
  // slugs from CATEGORY_GROUPS in src/lib/enums.ts.
  gender         String?    // "female" | "male" | "nonbinary" | "prefer-not-to-say"
  interestsJson  String     @default("[]")
  // Aggregate exposure score driving feed ranking + recommendations.
  exposureScore Float   @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  products       Product[]         @relation("SellerProducts")
  posts          Post[]            @relation("DesignerPosts")
  ordersAsBuyer  Order[]           @relation("BuyerOrders")
  ordersAsSeller Order[]           @relation("SellerOrders")
  sentMessages   Message[]         @relation("MessageSender")
  chatMembers    ChatParticipant[]
  favorites      Favorite[]
  likes          Like[]
  sketches       Sketch[]
  promotions     Promotion[]
  cart           Cart?
  comments       Comment[]
  followedBy     Follow[]          @relation("FollowedDesigner")
  following      Follow[]          @relation("Follower")
  // Wallet (1:1 â€” provisioned at first sale or first wallet view).
  wallet         Wallet?
  // Account/shop manager links â€” accounts this user OWNS, and accounts
  // they MANAGE for someone else.
  managedAccounts Manager[]        @relation("Owner")
  managingFor     Manager[]        @relation("ManagerUser")
  verificationRequests VerificationRequest[]
  roleChangeRequests RoleChangeRequest[]
  payoutRequests PayoutRequest[]
  businessNameChangeRequests BusinessNameChangeRequest[]
  addresses     Address[]
  sellerReviewsReceived SellerReview[] @relation("SellerReviewsReceived")
  sellerReviewsWritten  SellerReview[] @relation("SellerReviewsWritten")
  messageReactions      MessageReaction[]
  pushTokens            PushToken[]
  commissionsAsBuyer    CommissionRequest[] @relation("BuyerCommissions")
  commissionsAsDesigner CommissionRequest[] @relation("DesignerCommissions")
  preordersAsBuyer      Preorder[] @relation("BuyerPreorders")
  preordersAsDesigner   Preorder[] @relation("DesignerPreorders")
  collections           Collection[]
  // Referral program â€” every user gets a code at signup (see lib/referrals.ts).
  // pointsBalance is the running total maintained alongside the ledger so the
  // dashboard doesn't have to sum the whole ledger on every render.
  referralCode          String?     @unique
  pointsBalance         Int         @default(0)
  referralsByMe         Referral[]  @relation("ReferralsByMe")
  myReferrer            Referral?   @relation("MyReferrer")
  pointsLedger          PointsLedger[]
  recentlyViewed        RecentlyViewed[]
  promoCodeRedemptions  PromoCodeRedemption[]
  notifications         Notification[]
  savedPaymentMethods   SavedPaymentMethod[]
  dailyCheckIns         DailyCheckIn[]
  couponClaims          CouponClaim[]
}

// Expo push tokens. One row per device â€” the same user may install on
// iOS + Android, so we don't UNIQUE on (userId). Token itself is unique
// to allow upsert-by-token (a device re-registering with a new install
// overwrites the old row instead of duplicating it). Rows are removed
// when Expo returns a DeviceNotRegistered receipt â€” see sendPush in
// src/lib/notifications.ts.
model PushToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String?  // "ios" | "android" â€” best-effort, used for analytics only
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// Saved addresses (address book).
//
// One record per place the user wants to reuse â€” DELIVERY for buyers shipping
// to a recurring location, PICKUP for sellers' warehouse/store. A user can
// have many of each. The `isDefault` flag is enforced as "at most one default
// per (userId, kind)" by application code (no Prisma partial-unique support
// on SQLite â€” see /api/account/addresses for the transactional guard).
model Address {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // "DELIVERY" | "PICKUP" â€” same model serves buyer and seller use cases.
  kind              String
  // Optional human label like "Home", "Office", "Aba warehouse".
  label             String?
  // Contact for couriers (defaults to User.phone if blank).
  phone             String?
  // Verified Google-formatted address string. This is what Shipbubble's
  // /shipping/address/validate accepts as-is.
  formattedAddress  String
  placeId           String?
  latitude          Float?
  longitude         Float?
  // Coarse fields kept for zone/locality queries (within-city checks etc.).
  city              String?
  region            String?
  country           String?
  isDefault         Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId, kind])
  @@index([userId, kind, isDefault])
}

// Business-name change queue. A user submits one of these to ask the admin
// to swap their current `businessName` for a new one. The admin approves
// (applies the change atomically, updates `businessName` + `businessNameLower`
// on the user) or rejects (no-op, optional decision note). Status values
// mirror VerificationRequest: PENDING | APPROVED | REJECTED.
model BusinessNameChangeRequest {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Snapshot of the user's current businessName at submission time. Lets
  // the admin see the swap context even if the user later modifies the
  // row through some other flow.
  currentName     String?
  requestedName   String
  requestedLower  String
  status          String   @default("PENDING")
  reviewerId      String?
  reviewedAt      DateTime?
  decisionNote    String?
  createdAt       DateTime @default(now())

  @@index([status, createdAt])
  @@index([userId])
}

// -------------------- Wallet & payouts --------------------

// One wallet per user. Balance stored in cents (integer USD-cents) so we
// never lose precision to float math. Display goes through the local-
// currency formatter the same way Product.price does.
model Wallet {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balanceCents Int      @default(0)
  // Funds credited from a sale that hasn't been delivered to the buyer yet.
  // Withdrawable balance = balanceCents - heldCents. Decreases when the
  // related order moves to COMPLETED (release) or CANCELLED (claw back).
  heldCents    Int      @default(0)
  // The wallet operates in USD internally â€” currency display happens at the
  // UI layer via the CurrencyProvider context.
  currencyCode String   @default("USD")
  transactions WalletTransaction[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Append-only ledger. Sales credit the seller (positive), platform fee
// debits (negative), payouts debit, refunds credit, etc.
model WalletTransaction {
  id          String   @id @default(cuid())
  walletId    String
  wallet      Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  // Signed amount in cents. Positive = credit, negative = debit.
  amountCents Int
  // SALE_CREDIT | PLATFORM_FEE | WITHDRAWAL | WITHDRAWAL_FEE | REFUND | ADJUSTMENT
  type        String
  description String
  // PENDING | COMPLETED | FAILED
  status      String   @default("COMPLETED")
  // Optional reference to the related row (orderId, payoutRequestId, etc.).
  refType     String?
  refId       String?
  createdAt   DateTime @default(now())

  @@index([walletId, createdAt])
}

// Withdrawal request â€” captures bank details and tracks Monnify status.
model PayoutRequest {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountCents     Int
  // Bank details serialised as JSON: { bankCode, accountNumber, accountName }
  destinationJson String
  // PENDING | PROCESSING | PAID | FAILED | CANCELLED
  status          String   @default("PENDING")
  // External reference returned by Monnify (transactionReference).
  externalRef     String?
  failureReason   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId, createdAt])
}

// -------------------- Account / shop managers --------------------

// Links an owner (seller/designer) to a manager (another User account)
// with a JSON list of permission keys. Unique per (owner, manager) pair so
// a manager can't be added twice.
model Manager {
  id              String   @id @default(cuid())
  ownerId         String
  owner           User     @relation("Owner", fields: [ownerId], references: [id], onDelete: Cascade)
  managerId       String
  manager         User     @relation("ManagerUser", fields: [managerId], references: [id], onDelete: Cascade)
  // "manager" (default) | "rider"  â€” controls which surface they see when
  // they log in. Riders land on /rider; managers stay on the regular
  // dashboards their permissions allow.
  role            String   @default("manager")
  // Optional contact number â€” useful for delivery riders so buyers can call.
  phone           String?
  // JSON array of permission strings, e.g. ["edit_products","manage_orders","reply_messages"]
  // See PERMISSION_KEYS in src/lib/managers.ts.
  permissionsJson String   @default("[]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([ownerId, managerId])
  @@index([managerId])
  @@index([ownerId, role])
}

// -------------------- Verification --------------------

// A request a seller/designer files to be verified by the platform.
// Admins approve or reject; on approve, sellerVerified/designerVerified
// flips on the User row.
model VerificationRequest {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // SELLER | DESIGNER
  kind          String
  // Which tier the requester is applying for.
  //   2 = blue check (identity verification via NIN / Passport / Driver's License).
  //   3 = gold check (business verification via CAC document + optional storefront photo).
  // Tier 3 applications require the user to already be Tier 2.
  tier          Int       @default(2)
  // Tier 2 identity fields. idType: "NIN" | "PASSPORT" | "DRIVERS_LICENSE".
  idType        String?
  idNumber      String?
  // CDN URL for the photo / scan of the actual ID document. The number
  // alone is too easy to fabricate â€” having a legible image of the card
  // lets admins eyeball it for tampering, name match, and expiry.
  idDocumentUrl String?
  // PENDING | APPROVED | REJECTED
  status        String    @default("PENDING")
  // Business fields â€” replace the old free-text "tell us about yourself" with
  // structured intake so admins can decide in seconds.
  businessName    String?
  businessAddress String?
  // True when the requester has a brick-and-mortar shop (image of storefront
  // becomes the primary evidence). False when they're online-only (CAC
  // certificate becomes mandatory).
  hasPhysicalStore Boolean @default(false)
  // CDN URL for the storefront photo (required if hasPhysicalStore).
  storeImageUrl   String?
  // CDN URL for the CAC certificate PDF/image (required if !hasPhysicalStore;
  // optional otherwise).
  cacDocumentUrl  String?
  // Free-text from the requester â€” kept as supplemental context.
  notes         String?
  // JSON array of extra {label, url} document references the requester wants
  // to share (press, certifications, etc.).
  documentsJson String    @default("[]")
  reviewerId    String?
  reviewedAt    DateTime?
  decisionNote  String?
  createdAt     DateTime  @default(now())

  @@index([status, createdAt])
}

// -------------------- Order updates (tracking timeline) --------------------
// Lightweight timeline so buyers can watch their order move toward them
// without DMing the seller. The seller posts an update from /seller/orders/[id];
// the buyer sees it on /account/orders/[id].
model OrderUpdate {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // STATUS | DISPATCHED | ARRIVING | NOTE
  kind      String
  // Human-readable text the seller wrote â€” shown verbatim in the timeline.
  message   String
  // Optional ETA for arrival; populated for "DISPATCHED" / "ARRIVING" kinds.
  etaAt     DateTime?
  // Author â€” the seller or a manager acting on their behalf.
  createdById String
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}

// -------------------- Admin email broadcasts --------------------
// Tracks bulk emails the admin sends from the dashboard so we have an audit
// trail of who got what. The actual delivery goes through src/lib/email.ts.
model EmailBroadcast {
  id          String   @id @default(cuid())
  createdById String
  subject     String
  // Plain text / HTML body. Stored verbatim so re-sends are reproducible.
  body        String
  // ALL | BUYERS | SELLERS | DESIGNERS | VERIFIED | SPECIFIC
  audience    String
  // When audience=SPECIFIC, the resolved recipient userIds (JSON array).
  recipientIdsJson String @default("[]")
  recipientCount Int      @default(0)
  // Number actually accepted by the provider (Resend etc.).
  sentCount   Int      @default(0)
  // STUB | SENT | PARTIAL | FAILED
  status      String   @default("STUB")
  errorNote   String?
  // Per-recipient failures captured at send time. JSON array of
  // { email, error } objects so the admin can see exactly which
  // addresses failed and why (rate limit vs invalid vs bounce, etc.).
  failuresJson String  @default("[]")
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

// -------------------- Categories --------------------
// Admin-managed category list. The legacy CATEGORY_GROUPS const in
// src/lib/enums.ts is the seed; admins can add new categories from
// /admin/categories without a code change. Products reference categories
// by their `name` (not id) so existing rows keep working.

model Category {
  id           String   @id @default(cuid())
  // Display name â€” must be unique. Used as the literal value stored on
  // Product.category, Post tags, AI prompts, search filters. Renaming an
  // existing category currently breaks references; the admin UI surfaces
  // a warning before allowing a rename.
  name         String   @unique
  // Group for the homepage category rail: Materials | Clothing |
  // Accessories | Beauty | (admin can introduce new groups freely).
  groupName    String   @default("Clothing")
  // Drives storefront sort order within the group. Lower = earlier.
  displayOrder Int      @default(100)
  // Multi-level navigation: a category can have a parent so the storefront
  // drill-down can render top -> mid -> leaf without inventing a new model.
  // null means top-level.
  parentId     String?
  parent       Category? @relation("CategoryParent", fields: [parentId], references: [id], onDelete: SetNull)
  children     Category[] @relation("CategoryParent")
  // Lets admins retire a category without deleting it. Disabled categories
  // hide from buyer-facing dropdowns but the historical Product.category
  // values keep resolving.
  enabled      Boolean  @default(true)
  // Categorisation kind â€” when an admin adds a fabric category we want
  // products created in it to land on the Materials rail. Mirrors the
  // kindForCategory() switch in enums.ts. Values: "MATERIAL" | "PRODUCT".
  kind         String   @default("PRODUCT")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// -------------------- Referrals & points --------------------
// Each user gets a referral code at signup. When a new user signs up with
// `?ref=<code>` we record the relationship and credit points to the
// referrer (and optionally to the new user). Points are spendable later
// (rules tbd); this schema just bookkeeps balance + ledger.

model Referral {
  id           String   @id @default(cuid())
  // Who invited the new user.
  referrerId   String
  referrer     User     @relation("ReferralsByMe", fields: [referrerId], references: [id], onDelete: Cascade)
  // The new user who signed up via the referrer's code.
  refereeId    String   @unique
  referee      User     @relation("MyReferrer", fields: [refereeId], references: [id], onDelete: Cascade)
  // Snapshot of the code at capture time so a later code-change on the
  // referrer doesn't rewrite history.
  codeUsed     String
  // Whether the referee has reached the "qualified" milestone (first
  // completed order). Drives when the milestone bonus pays out.
  qualifiedAt  DateTime?
  createdAt    DateTime @default(now())

  @@index([referrerId])
}

model PointsLedger {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Positive credit / negative debit.
  delta     Int
  // Human-readable reason: "referral:signup", "referral:qualified",
  // "spend:order:<id>", "admin:adjust", etc.
  reason    String
  // Optional pointer to the source entity (referral id, order id, etc.) so
  // the admin UI can link straight to the cause.
  refId     String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// -------------------- Products --------------------

model Product {
  id          String   @id @default(cuid())
  sellerId    String
  seller      User     @relation("SellerProducts", fields: [sellerId], references: [id], onDelete: Cascade)
  name        String
  description String
  price       Float
  // Optional sale price for flash-sale / discount display.
  salePrice   Float?
  // Category from the fashion-only allowlist in src/lib/enums.ts â†’ CATEGORIES.
  category    String
  // Higher-level grouping used on the homepage rails.
  // Values: "MATERIAL" (fabrics + sewing supplies) or "PRODUCT" (everything else).
  kind        String   @default("PRODUCT")
  // The unit `price` is quoted in. Defaults to "piece" so existing rows keep
  // their meaning; sellers of fabrics pick "yard" / "meter" / "foot" so the
  // cart can render qty + unit and multiply correctly. Whitelist lives in
  // src/lib/units.ts (PRODUCT_UNITS).
  unit        String   @default("piece")
  // Optional size list for sized products (clothing, shoes, bags). JSON
  // array of strings. Empty for materials and unsized items. Seller picks
  // the relevant scale on the listing form (XS-XXL, EU shoe sizes, etc.);
  // the buyer picks one at add-to-cart time.
  sizesJson   String   @default("[]")
  // Seller-defined attribute groups (colors, finishes, fabrics, etc.). JSON
  // array of `{ name: string, options: string[], required: boolean }`. The
  // buyer picks one option per group when adding to cart and the choice
  // flows through to the Order so the seller knows which variant to ship.
  // Schema lives in src/lib/productAttributes.ts. Empty array means the
  // product has no buyer-selectable variants.
  attributesJson String @default("[]")
  // DRAFT | ACTIVE | SOLD_OUT | ARCHIVED
  status      String   @default("ACTIVE")
  // JSON-encoded array of image URLs (SQLite has no native string[]).
  imagesJson  String   @default("[]")
  // JSON array of dominant hex colors extracted from product images at upload
  // time. Used by the deterministic SmartSearch image matcher. Empty by default
  // â€” older products without colors fall back to text-only matching.
  dominantColorsJson String @default("[]")
  // Free-form lowercase tags for the search bot (e.g. ["oversized", "boho",
  // "linen"]). Sellers can leave blank; bot still works on name+description.
  tagsJson    String   @default("[]")
  // Lightweight stock counter for the cart flow.
  stock       Int      @default(99)
  // Engagement counters used for ranking.
  viewCount   Int      @default(0)
  likeCount   Int      @default(0)
  saveCount   Int      @default(0)
  salesCount  Int      @default(0)
  // Average rating (computed in app code from Review aggregations).
  ratingAvg   Float    @default(0)
  ratingCount Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orders     Order[]
  favorites  Favorite[]
  likes      Like[]
  promotions Promotion[]
  sketches   Sketch[]
  cartItems  CartItem[]
  reviews    Review[]
  collectionItems CollectionItem[]
  recentlyViewed RecentlyViewed[]
}

// -------------------- Posts (Designers) --------------------

model Post {
  id         String   @id @default(cuid())
  authorId   String
  author     User     @relation("DesignerPosts", fields: [authorId], references: [id], onDelete: Cascade)
  title      String
  body       String
  imagesJson String   @default("[]")
  tagsJson   String   @default("[]")
  viewCount  Int      @default(0)
  likeCount  Int      @default(0)
  saveCount  Int      @default(0)
  // Preorder configuration. When `preorderEnabled` is true and both
  // price + lead are set, buyers can preorder the piece in this post
  // from the feed / homepage rail. The buyer pays the design price
  // upfront, the designer makes the piece within `preorderLeadDays`,
  // then the buyer pays delivery separately and the piece ships.
  // Stored on Post (not a separate table) because most preorderable
  // posts will keep their config attached for the post's lifetime.
  preorderEnabled    Boolean @default(false)
  preorderPriceCents Int?
  preorderLeadDays   Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  favorites  Favorite[]
  likes      Like[]
  promotions Promotion[]
  sketches   Sketch[]
  comments   Comment[]
  collectionItems CollectionItem[]
  preorders  Preorder[]
}

// -------------------- Comments on posts --------------------

model Comment {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([postId, createdAt])
}

// -------------------- Follows (buyers/sellers follow designers) --------------------

model Follow {
  id           String   @id @default(cuid())
  followerId   String
  follower     User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  designerId   String
  designer     User     @relation("FollowedDesigner", fields: [designerId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@unique([followerId, designerId])
}

// -------------------- Cart --------------------

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  // Float so fabrics can be added by the half-yard / fraction. For
  // piece-priced products the API still rejects fractional values.
  quantity  Float    @default(1)
  // Optional size for sized goods (clothing, shoes, bags). NULL for
  // materials and unsized items. Two carts of the same product in
  // different sizes overwrite today (unique constraint is on
  // cartId+productId, not size) â€” acceptable for V1, revisit if buyers
  // start asking for it.
  size      String?
  // Buyer's pick from the product's attribute groups, e.g.
  // `{"Color":"Blue","Size":"M"}`. JSON object, validated against the
  // product's `attributesJson` at add-to-cart time. Empty object means
  // the product had no attribute groups (or the buyer wasn't required
  // to pick anything).
  selectedAttributesJson String @default("{}")
  createdAt DateTime @default(now())

  @@unique([cartId, productId])
}

// -------------------- Orders --------------------

model Order {
  id              String   @id @default(cuid())
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  buyerId         String
  buyer           User     @relation("BuyerOrders", fields: [buyerId], references: [id], onDelete: Cascade)
  sellerId        String
  seller          User     @relation("SellerOrders", fields: [sellerId], references: [id], onDelete: Cascade)
  // Float to mirror CartItem.quantity â€” fabric orders can be 2.5 yards.
  quantity        Float    @default(1)
  totalPrice      Float
  // PENDING | PAID | SHIPPED | COMPLETED | CANCELLED
  status          String   @default("PENDING")
  shippingAddress String?
  // Structured shipping address fields, populated when buyer picks an address via
  // the Google Places picker at checkout. shippingAddress mirrors formattedAddress
  // for backwards compatibility with code that reads the legacy column.
  shippingFormattedAddress String?
  shippingLatitude         Float?
  shippingLongitude        Float?
  shippingPlaceId          String?
  notes           String?
  // Frozen copy of CartItem.selectedAttributesJson at checkout time. Sellers
  // read this on the order page to know which colour / finish / variant to
  // pack. Schema mirrors src/lib/productAttributes.ts. Empty object means
  // the product had no buyer-selectable attribute groups.
  selectedAttributesJson String @default("{}")
  // "DIRECT" (pay upfront via Monnify) | "ON_DELIVERY" (pay cash on arrival).
  // ON_DELIVERY is gated on User.trustedBuyer â€” see /api/cart/checkout.
  paymentMethod   String   @default("DIRECT")
  // Set when payment is confirmed. `expectedDeliveryBy` is the deadline after
  // which buyers can self-cancel a paid-but-undelivered order; default window
  // is 14 days from paidAt (see DELIVERY_WINDOW_DAYS in lib/orders.ts).
  paidAt          DateTime?
  expectedDeliveryBy DateTime?
  completedAt     DateTime?
  // Shared by every Order in a single checkout group. Used to correlate
  // Monnify webhook events (which arrive per paymentReference, not per order)
  // back to the rows that need to be finalised.
  paymentReference String?
  // External transaction reference returned by Monnify or Korapay after a successful
  // payment. Stored for support / reconciliation.
  paymentTxnRef   String?
  // Payment gateway used: "KORAPAY" | "MONNIFY"
  paymentGateway  String   @default("MONNIFY")
  // Delivery fee snapshotted at order time so a later seller-side rate
  // change doesn't retroactively alter what the buyer was charged.
  deliveryFeeCents Int     @default(0)
  // "WITHIN_CITY" | "OUTSIDE_CITY" | "OUTSIDE_COUNTRY" | "UNKNOWN"
  deliveryZone    String   @default("UNKNOWN")
  // Who carries out the delivery: "PLATFORM" (admin-supported city + seller
  // has no rider) or "SELLER" (seller's own rider; fee credited to wallet
  // minus admin's DELIVERY_PLATFORM_CUT_BPS).
  deliveryFulfiller String @default("SELLER")
  // 4-char alphanumeric code the buyer shares with the dispatch rider on
  // arrival. The rider confirms delivery by entering this code â€” released
  // funds + COMPLETED status all flow from a verified match. Stored as a
  // string so leading zeros / letters are preserved.
  deliveryCode    String?
  // True when delivery was confirmed by a rider keying in the deliveryCode;
  // false when the buyer pressed "Confirm delivery" themselves. Useful for
  // analytics + dispute resolution.
  completedByRider Boolean @default(false)
  // Tracking code from logistics provider (denormalized for quick access on order detail).
  trackingCode    String?
  // Logistics provider used: "SENDBOX" | "JUMIA" | etc. Set after shipment creation.
  logisticsProvider String?
  updates         OrderUpdate[]
  shipment        Shipment?
  shippingRates   ShippingRate[]
  sellerReview    SellerReview?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([paymentReference])
}

// -------------------- Shipments (Logistics) --------------------

// One shipment per order. Tracks logistics provider integration, tracking code,
// label URL, and shipment status.
model Shipment {
  id          String   @id @default(cuid())
  orderId     String   @unique
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // Logistics provider name: "SENDBOX" | "JUMIA" | "DELLYMAN" | etc.
  provider    String
  // External shipment ID from the logistics provider
  externalId  String
  // Tracking code the buyer sees to track delivery
  trackingCode String
  // Courier/shipping method selected: e.g., "Economy", "Standard", "Express"
  courierName String?
  // URL to download shipping label PDF from provider
  labelUrl    String?
  // URL to receipt/invoice/waybill from provider (if available)
  receiptUrl  String?
  // Shipment status: PENDING | PICKED | IN_TRANSIT | OUT_FOR_DELIVERY | DELIVERED | FAILED
  status      String   @default("PENDING")
  // Seller's reference for the shipment
  sellerReference String?
  // Estimated delivery date from provider
  estimatedDeliveryAt DateTime?
  // Last sync time with logistics provider
  lastSyncedAt DateTime?
  // Shipping fees charged in cents
  shippingFeeCents Int @default(0)
  // Sender details snapshot at shipment time
  senderName    String?
  senderPhone   String?
  senderAddress String?
  // Recipient details
  recipientName    String?
  recipientPhone   String?
  recipientAddress String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // New columns requested for Shipbubble/Kwik delivery
  courier          String?
  courier_id       String?
  tracking_number  String?
  request_token    String?
  shipping_fee     Float?
  eta              DateTime?
  shipment_status  String?
  tracking_history String?

  @@index([orderId])
  @@index([provider])
  @@index([status])
  @@unique([orderId, provider])
}

// -------------------- Shipping Rates (Logistics Quotes) --------------------

// Snapshots of shipping rate quotes shown to buyers during checkout.
// Allows tracking which rates were presented and which was selected.
model ShippingRate {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // Provider name: "SENDBOX" | "JUMIA" | etc.
  provider    String
  // Courier/method name: "Economy", "Standard", "Express"
  courierName String
  // Quote amount in cents (USD)
  amountCents Int
  // Estimated delivery days from quote
  estimatedDays Int?
  // Estimated delivery date
  estimatedDeliveryAt DateTime?
  // Whether this rate was selected for the order
  selected    Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([orderId])
  @@index([provider])
  @@index([selected])
}

// -------------------- Reviews --------------------

model Review {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  authorId  String
  rating    Int      // 1..5
  body      String?
  createdAt DateTime @default(now())

  @@unique([productId, authorId])
  @@index([productId])
}

// -------------------- Seller Reviews --------------------
//
// One review per delivered order, written by the buyer about the seller.
// Distinct from `Review` (which is per-product). Eligibility is enforced
// by the API layer: only the buyer on a COMPLETED order can write here,
// and only within 30 days of completion. After the window the row is
// frozen (no PATCH) â€” see /api/seller-reviews.
model SellerReview {
  id        String   @id @default(cuid())
  // The order this review covers. One review per order â€” the unique
  // constraint makes idempotent upserts straightforward.
  orderId   String   @unique
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sellerId  String
  seller    User     @relation("SellerReviewsReceived", fields: [sellerId], references: [id], onDelete: Cascade)
  buyerId   String
  buyer     User     @relation("SellerReviewsWritten",  fields: [buyerId], references: [id], onDelete: Cascade)
  rating    Int      // 1..5
  body      String?
  // Whether the buyer has revised the rating from their first submission.
  // Surfaced as a small "edited" indicator in the UI for transparency.
  edited    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sellerId, createdAt])
  @@index([buyerId, createdAt])
}

// -------------------- Chat / Messaging --------------------

model Chat {
  id           String            @id @default(cuid())
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  participants ChatParticipant[]
  messages     Message[]
}

model ChatParticipant {
  id       String   @id @default(cuid())
  chatId   String
  chat     Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt DateTime @default(now())
  // Read receipt cursor: every message in this chat with createdAt <= lastReadAt
  // is considered read by this participant. Updated by the read endpoint when
  // the chat is open and new messages roll in. Read state for individual
  // messages is derived from this cursor â€” saves a per-message write per poll.
  lastReadAt   DateTime?
  // Typing indicator. Client heartbeats this field while the user is typing;
  // the peer's poll reads it and compares against `now() - 5s` to decide
  // whether to show "Alex is typingâ€¦". Stale entries are ignored, so no
  // explicit "stopped typing" message is needed.
  lastTypingAt DateTime?

  @@unique([chatId, userId])
}

model Message {
  id        String    @id @default(cuid())
  chatId    String
  chat      Chat      @relation(fields: [chatId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User      @relation("MessageSender", fields: [senderId], references: [id])
  body      String
  // Quoted reply: parent message id. Null for top-level messages. The
  // relation is intentionally NOT cascade â€” deleting the parent shows
  // "original message deleted" in the reply UI rather than wiping the
  // child too.
  replyToId String?
  replyTo   Message?  @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   Message[] @relation("MessageReplies")
  // Image attachment. The chat UI uploads via /api/upload first, then
  // stores the resulting URL + mime here. Body can still hold a caption.
  attachmentUrl  String?
  attachmentMime String?
  // Original filename + size of the upload. Surfaced in the file-card UI
  // for non-media attachments (PDF / docx / etc.) so the recipient sees
  // what's there before downloading.
  attachmentName String?
  attachmentSize Int?
  // Edit / delete state. `editedAt` set when the sender revises body; UI
  // shows an "edited" indicator. `deletedAt` is a soft-delete â€” body
  // and attachment are blanked client-side but the row stays so the
  // surrounding conversation reads coherently.
  editedAt  DateTime?
  deletedAt DateTime?
  readAt    DateTime?
  // Client-generated UUID used to make sends idempotent. The server uses it
  // as a "have I seen this before?" check; identical retries collapse to one
  // row. Optional so legacy rows and non-idempotent callers still work â€”
  // the unique constraint only collides when both sides provide a value.
  clientMessageId String?
  createdAt DateTime  @default(now())
  // Bumped on edit, delete, reaction change. The polling endpoint uses it
  // to ship "updated since X" payloads without re-fetching the whole
  // window.
  updatedAt DateTime  @updatedAt

  reactions MessageReaction[]

  @@index([chatId, createdAt])
  @@index([chatId, updatedAt])
  @@unique([chatId, senderId, clientMessageId])
}

// Emoji reactions on individual messages. WhatsApp-style â€” one reaction
// per (message, user, emoji) tuple, but a user can stack multiple emojis
// on the same message if they want. Toggle semantics: the API endpoint
// creates the row if absent, deletes if present.
model MessageReaction {
  id        String  @id @default(cuid())
  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime @default(now())

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

// -------------------- Favorites / Wishlist & Likes --------------------

// A "favorite" doubles as the buyer wishlist for products and a saved-posts list.
model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  postId    String?
  post      Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@unique([userId, postId])
  @@index([userId])
}

model Like {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  postId    String?
  post      Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@unique([userId, postId])
  @@index([userId])
}

// -------------------- Promotions --------------------

// Product promotions (paid) and post promotions (free, legacy).
//
// Product flow (paid, fixed â‚¦500 / 3-day, admin-approved):
//   PENDING_PAYMENT  â†’ seller created the request, awaiting Monnify
//                      callback. `active=false`. `endsAt` is a placeholder.
//   PENDING_REVIEW   â†’ payment succeeded; waits for admin approval.
//                      `paidAt` is set, `paymentTxnRef` carries the Monnify ref.
//   APPROVED         â†’ admin approved. `startsAt`=approval time,
//                      `endsAt`=startsAt+3d, `active=true`. Shows on the
//                      homepage slider above featured pieces.
//   REJECTED         â†’ admin declined. Fee auto-refunded to the seller's
//                      wallet (see /api/admin/promotions/[id]).
//   CANCELLED        â†’ Monnify reported FAILED_TRANSACTION â€” buyer abandoned.
//
// Post flow (legacy, free): created directly as APPROVED + active.
model Promotion {
  id            String   @id @default(cuid())
  ownerId       String
  owner         User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  productId     String?
  product       Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  postId        String?
  post          Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  boost         Float    @default(1.5)
  // Status lives in lib/enums.ts as PromotionStatus. SQLite stores it as a
  // string. Existing free post promotions migrate to "APPROVED".
  status        String   @default("APPROVED")
  // Stored as Monnify-compatible kobo (50000 = â‚¦500). Zero for free post
  // promotions so the wallet refund step on rejection is a no-op.
  priceCents    Int      @default(0)
  // Monnify reference written at creation time; used as the webhook
  // paymentReference and also as the idempotency key when the webhook
  // marks the promo paid.
  paymentReference String? @unique
  paymentTxnRef String?
  paidAt        DateTime?
  reviewerId    String?
  reviewedAt    DateTime?
  decisionNote  String?
  startsAt      DateTime @default(now())
  endsAt        DateTime
  // Mirrors `status === "APPROVED" && endsAt > now`. Kept as a column so
  // existing queries that just check `active=true` keep working.
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  @@index([active, endsAt])
  @@index([status, endsAt])
}

// -------------------- Search learning log --------------------

// Records every search the bot serves, plus which result the user clicked.
// The ranker reads recent rows to bias future results toward what worked
// for similar queries. This is the "controlled learning" â€” it's a stats
// table, not an opaque model, so behavior is predictable and auditable.
model SearchLog {
  id              String   @id @default(cuid())
  // Lowercased, normalized text query (or "image" for image-only searches).
  queryNorm       String
  // Which top-level signal triggered the search ("text", "image").
  source          String   @default("text")
  userId          String?
  // The first product the user clicked from this query, if any. Null if
  // they never clicked â€” those rows still teach the bot the query gave
  // poor results.
  clickedProductId String?
  createdAt       DateTime @default(now())

  @@index([queryNorm, createdAt])
  @@index([clickedProductId])
}

// -------------------- Sketches --------------------

model Sketch {
  id        String   @id @default(cuid())
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title     String
  // Garment hint for the (eventual) 3D mockup pipeline.
  // Values: shirt | gown | hoodie | trousers | skirt | agbada | dress | native | other
  garment   String   @default("other")
  imageData String
  productId String?
  product   Product? @relation(fields: [productId], references: [id])
  postId    String?
  post      Post?    @relation(fields: [postId], references: [id])
  createdAt DateTime @default(now())
}

// -------------------- Delivery cities (platform-served) --------------------
// A whitelist of (country, city) pairs the platform offers in-house delivery
// in. Admin manages this. When BOTH the buyer and seller are in the same
// entry, checkout uses the admin's `feeCents` (with a platform cut taken
// off the top). Outside this list, sellers must use their own riders and
// rates. See src/lib/location.ts â†’ resolveDeliveryQuote.
model DeliveryCity {
  id        String   @id @default(cuid())
  // ISO-3166 alpha-2 country code (matches User.country).
  country   String
  // Display name. Comparisons are case-insensitive + trimmed; see normCity
  // helper in location.ts.
  name      String
  region    String?
  // Platform-set delivery fee for within-city orders in this city, USD-cents.
  feeCents  Int      @default(0)
  // Soft-disable without deleting (keeps historical orders interpretable).
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([country, name])
  @@index([active])
}

// -------------------- SiteSetting (admin-editable runtime config) --------------------
// Key/value overrides for things that used to be plain env vars. The
// getter in src/lib/settings.ts checks this table first and falls back to
// process.env. Only a curated whitelist of keys is exposed in the admin UI
// (see SETTINGS_DEFINITIONS) â€” secrets like JWT_SECRET stay env-only.
model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
  updatedBy String?
}

// -------------------- Shipbubble Address Code Cache --------------------
model ShipbubbleAddressCode {
  id          String   @id @default(cuid())
  addressKey  String   @unique
  addressCode String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// -------------------- Commission Requests --------------------
// Custom-design requests from buyers to designers. Replaces the informal
// chat-based commission flow with a structured brief â†’ quote â†’ accept â†’
// deliver pipeline that's auditable and notifies both sides at every step.
//
// Status machine (see src/lib/commissions.ts for transitions):
//   REQUESTED  â†’ designer hasn't responded yet
//   QUOTED     â†’ designer named a price + estimated days
//   ACCEPTED   â†’ buyer accepted the quote (payment happens off-platform
//                in V1 â€” a "Mark as paid" admin action wires real
//                payments later)
//   DECLINED   â†’ designer or buyer walked away during negotiation
//   IN_PROGRESS â†’ designer started work
//   DELIVERED  â†’ designer marked delivery + supplied a code
//   COMPLETED  â†’ buyer confirmed delivery with the code (releases payout)
//   CANCELLED  â†’ either party cancelled after accept
model CommissionRequest {
  id          String   @id @default(cuid())
  buyerId     String
  buyer       User     @relation("BuyerCommissions", fields: [buyerId], references: [id], onDelete: Cascade)
  designerId  String
  designer    User     @relation("DesignerCommissions", fields: [designerId], references: [id], onDelete: Cascade)

  // Brief â€” what the buyer wants
  title       String
  occasion    String?    // "Wedding", "Aso Ebi", "Birthday", free-form
  description String
  budgetCents Int?       // buyer's max budget in NGN cents (â‚¦ * 100), optional
  deadlineAt  DateTime?  // when the buyer needs it
  // JSON array of image URLs the buyer attached as visual references.
  referencesJson String  @default("[]")

  // Quote â€” what the designer responds with
  quoteCents     Int?
  quoteNote      String?
  quotedAt       DateTime?
  estimatedDays  Int?

  // Fulfillment â€” same delivery-code pattern as the regular Order flow so
  // a buyer hands over the code on receipt and the designer's wallet is
  // credited.
  deliveryCode   String?
  deliveredAt    DateTime?
  completedAt    DateTime?

  // Free-text note appended on cancel / decline, surfaced in the timeline.
  cancellationReason String?

  status      String   @default("REQUESTED")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([buyerId])
  @@index([designerId])
  @@index([status])
}

// -------------------- Collections (look-books) --------------------
// Designer-curated bundles of posts (and optionally products) that present
// a body of work as a single shareable URL â€” e.g. "Aso Ebi Spring 2026".
// Public via /lookbook/[slug]. A collection is owned by exactly one user;
// posts/products on the join tables stay independently owned by their
// creators.
model Collection {
  id          String   @id @default(cuid())
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title       String
  // URL slug, lowercased + kebab-cased. Unique per owner so the same
  // designer can't have two "/lookbook/spring-2026" routes that conflict.
  slug        String
  description String?
  // Optional cover image URL. When null the public page falls back to the
  // first post/product image in the collection.
  coverUrl    String?
  // PUBLIC = visible at /lookbook/[slug], DRAFT = owner-only preview.
  status      String   @default("DRAFT")
  items       CollectionItem[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([ownerId, slug])
  @@index([status])
}

model CollectionItem {
  id            String     @id @default(cuid())
  collectionId  String
  collection    Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  // Exactly one of postId / productId is set per row. Discriminator pattern
  // rather than two tables keeps the ordering query trivial.
  postId        String?
  post          Post?      @relation(fields: [postId], references: [id], onDelete: Cascade)
  productId     String?
  product       Product?   @relation(fields: [productId], references: [id], onDelete: Cascade)
  // Display order within the collection. Owner-defined via drag in the
  // editor; rendered in ascending order on the public page.
  position      Int        @default(0)
  createdAt     DateTime   @default(now())

  @@index([collectionId, position])
  @@index([postId])
  @@index([productId])
}

// -------------------- Role Change Requests --------------------
// User-initiated request to gain or drop a role (seller / designer).
// Admin reviews from /admin/role-changes; on approve the corresponding
// flag(s) on User are updated. Buyer is implicit (everyone is a buyer),
// so we only model the two opt-in roles.
//
// We store the requested target as two explicit booleans rather than a
// single role string â€” lets a user request "add designer" without
// touching their seller status, and lets the admin still see what the
// user originally wanted even after their roles drift over time.
model RoleChangeRequest {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Snapshot of the user's roles at request time, for audit context.
  fromIsSeller   Boolean
  fromIsDesigner Boolean
  // Requested target state.
  toIsSeller     Boolean
  toIsDesigner   Boolean
  // Why does the user want this? Surfaced to admins in the review panel.
  reason        String?
  // PENDING | APPROVED | REJECTED | CANCELLED
  status        String   @default("PENDING")
  reviewerId    String?
  reviewedAt    DateTime?
  decisionNote  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status, createdAt])
  @@index([userId])
}


// -------------------- WhatsApp Concierge --------------------
// Audit + conversation history for the WhatsApp concierge integration.
// Each row is one message in either direction (IN = buyer-to-platform,
// OUT = platform-to-buyer). The webhook persists incoming messages
// before invoking the AI loop; the AI's reply persists as OUT(s) right
// after Meta's API confirms the send.
//
// We don't link to a User by FK at insert time because most senders won't
// have a StreekMart account when they first message us. A nullable
// userId is populated opportunistically when the phone matches an
// existing User row (see whatsapp.ts).
model WhatsAppMessage {
  id          String   @id @default(cuid())
  // Sender (for IN) or recipient (for OUT) phone in E.164 form
  // ("+2348012345678"). Always present.
  phone       String
  // "IN" = received from buyer, "OUT" = sent from platform.
  direction   String
  // Plain text body. Non-text messages (images, etc.) are stored as a
  // JSON description for now; rich types can come later.
  body        String
  // Meta's external message id. Unique on inbound rows so retried
  // webhook deliveries don't double-insert.
  externalId  String?  @unique
  // Optional link to a StreekMart user when we can resolve the phone.
  // Null otherwise â€” we still keep the conversation history.
  userId      String?
  // Free-text tag the AI loop can populate (e.g. "recommendation",
  // "greeting", "out-of-scope"). Useful for measuring how the bot is used.
  intent      String?
  createdAt   DateTime @default(now())

  @@index([phone, createdAt])
  @@index([externalId])
}


// -------------------- Meta Data Deletion Requests --------------------
// Required by Meta for any app handling user data â€” they POST to the
// configured "Data Deletion Callback URL" when a user requests deletion
// from their Facebook / WhatsApp account; we delete the corresponding
// data, return a confirmation_code, and let the user check status at
// /data-deletion/<code>.
//
// We don't always know which of our rows belong to the requesting user
// (the signed_request gives us a Meta-internal user_id, not necessarily
// a phone number) â€” phone is set when we could resolve it.
model DataDeletionRequest {
  id               String   @id @default(cuid())
  // Random hex string returned to Meta. Used by the public status page to
  // look up the row without leaking other PII.
  confirmationCode String   @unique
  // The Meta user_id from the signed_request payload â€” opaque to us.
  metaUserId       String
  // Phone we successfully matched against WhatsAppMessage history, if any.
  phone            String?
  // PENDING | COMPLETED | FAILED
  status           String   @default("PENDING")
  // How many WhatsApp message rows were removed for this request.
  deletedCount     Int      @default(0)
  // Free-text note (error reason on FAILED, "no matching data" when the
  // user had nothing stored, etc.).
  notes            String?
  createdAt        DateTime @default(now())
  completedAt      DateTime?

  @@index([metaUserId])
}


// -------------------- Preorders --------------------
// Buyer requests a designer's piece from the feed/home. Lifecycle:
//
//   PENDING_PAYMENT      â†’ buyer just clicked "Preorder", needs to pay the
//                          design price.
//   AWAITING_READY       â†’ design paid. Designer's wallet credited (skip-
//                          hold for verified Tier 2/3 designers so they
//                          can withdraw and buy materials).
//   READY                â†’ designer marked the piece ready. Buyer needs
//                          to pay delivery + supply shipping address.
//   AWAITING_SHIPMENT    â†’ delivery paid. Designer creates the actual
//                          shipment via the existing logistics flow.
//   SHIPPED              â†’ shipment created with tracking. Buyer sees
//                          delivery code.
//   COMPLETED            â†’ buyer confirmed receipt with the code.
//   CANCELLED            â†’ terminal failure (either side).
//
// Two payments, two gateway references:
//   designPaymentRef    = PREORDER_DESIGN_<id>
//   deliveryPaymentRef  = PREORDER_DELIVERY_<id>
// Webhook routes by prefix.
model Preorder {
  id          String   @id @default(cuid())
  buyerId     String
  buyer       User     @relation("BuyerPreorders", fields: [buyerId], references: [id], onDelete: Cascade)
  designerId  String
  designer    User     @relation("DesignerPreorders", fields: [designerId], references: [id], onDelete: Cascade)
  // The post the buyer requested. Nullable so a designer deleting a post
  // doesn't cascade-wipe in-flight preorders.
  postId      String?
  post        Post?    @relation(fields: [postId], references: [id], onDelete: SetNull)

  // Snapshot of the post's config at preorder time. Storing a copy here
  // means a designer raising / lowering the price later doesn't rewrite
  // what the buyer already agreed to pay.
  priceCents       Int
  leadDays         Int
  // Buyer's free-text notes (size, color, references).
  notes            String?

  status           String  @default("PENDING_PAYMENT")

  // Design payment
  designPaymentRef String?  @unique
  designPaymentTxnRef String?
  designPaidAt     DateTime?

  // Ready / production milestones
  readyAt          DateTime?
  // Computed at design payment time as designPaidAt + leadDays. Surfaced
  // to the buyer as the ETA.
  estimatedReadyAt DateTime?

  // Delivery payment + shipping
  deliveryFeeCents      Int?
  deliveryPaymentRef    String?  @unique
  deliveryPaymentTxnRef String?
  deliveryPaidAt        DateTime?
  shippingAddress       String?
  shippingFormattedAddress String?
  shippingLatitude      Float?
  shippingLongitude     Float?
  shippingPlaceId       String?

  // Fulfilment / shipment
  trackingCode     String?
  logisticsProvider String?
  shippedAt        DateTime?
  deliveryCode     String?
  completedAt      DateTime?

  cancellationReason String?
  cancelledAt        DateTime?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([buyerId])
  @@index([designerId])
  @@index([status, createdAt])
}

// -------------------- Recently viewed --------------------
// One row per (user, product) view. Reads dedupe by user+product so the
// rail shows distinct items, ordered by viewedAt desc. A buyer can have
// at most one row per product -- we upsert (updating viewedAt) instead of
// inserting a new row each visit. Rolling cap of 50 enforced by the
// /api/recently-viewed endpoint on write.
model RecentlyViewed {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  viewedAt  DateTime @default(now()) @updatedAt

  @@unique([userId, productId])
  @@index([userId, viewedAt])
}

// -------------------- Promo codes --------------------
// Flat-rate or percentage discount codes applied at /api/cart/checkout.
// Admin-created from /admin/promo-codes (built in Phase 2). usageLimit
// is the total redemption cap across all users; perUserLimit is the
// per-account cap. Usage tracking lives on PromoCodeRedemption rows so
// the cart endpoint can do an idempotent check.
model PromoCode {
  id            String   @id @default(cuid())
  code          String   @unique
  // FLAT in NGN cents; PERCENT in basis points (e.g. 1500 = 15%).
  kind          String   // FLAT | PERCENT
  value         Int
  // Optional cap on the dollar amount of the discount for PERCENT codes
  // (e.g. "15% off up to N5000"). Null = no cap.
  maxDiscountCents Int?
  // Minimum order subtotal in cents required to use the code.
  minSubtotalCents Int?
  // Total redemptions allowed (across all users). Null = unlimited.
  usageLimit    Int?
  perUserLimit  Int      @default(1)
  enabled       Boolean  @default(true)
  // Public claim-able. When true the code shows up on /account/coupons
  // and can be claimed (saved) by users before checkout.
  claimable     Boolean  @default(false)
  startsAt      DateTime?
  endsAt        DateTime?
  description   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  redemptions   PromoCodeRedemption[]
  claims        CouponClaim[]

  @@index([code, enabled])
}

model PromoCodeRedemption {
  id          String   @id @default(cuid())
  promoCodeId String
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Optional pointer to the order(s) this code was applied to. Stored as
  // the cart-batch paymentReference since one cart can produce N orders.
  paymentReference String?
  discountCents    Int
  createdAt   DateTime @default(now())

  @@index([promoCodeId, userId])
  @@index([userId])
}

// -------------------- Notifications inbox --------------------
// Persistent log of notifications shown to the user. Created alongside
// every sendPush() call so the inbox shows past notifications even if
// the push receipt was dismissed. readAt is set when the user opens the
// inbox or taps the notification.
model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Category tag: order | message | review | follow | promotion | system | preorder | commission | other
  type      String   @default("system")
  title     String
  body      String
  // Deep-link path the bell icon should open when tapped (/account/orders/<id>, /messages/<chatId>, etc.).
  link      String?
  // Free-form JSON payload (orderId, chatId, etc.) so client code can
  // resolve the target without re-parsing the link.
  dataJson  String?
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

// -------------------- Saved payment methods --------------------
// Card token + masked details returned by the gateway after a buyer
// opts to save a card at checkout. Populating this table requires the
// gateway-side tokenization flow (Korapay charge & save) -- the read +
// delete endpoints land first; the populate-on-checkout hook is wired
// from the Monnify/Korapay webhook once the gateway customer id is
// stored on the order.
model SavedPaymentMethod {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Gateway-side identifier for the saved card / wallet. NEVER the raw
  // PAN; only the gateway can resolve it back to a chargeable token.
  gateway     String   // KORAPAY | MONNIFY
  gatewayRef  String
  // Display details. Masked PAN like "**** **** **** 4242".
  maskedPan   String?
  brand       String?  // visa | mastercard | verve | amex
  expMonth    Int?
  expYear     Int?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@unique([userId, gateway, gatewayRef])
  @@index([userId, isDefault])
}

// -------------------- Daily check-in --------------------
// One row per (user, day-as-UTC-date). Inserting a row awards points.
// Idempotent: the unique constraint prevents double-claiming the same day
// even if the user double-taps. Streak length is computed in the API by
// counting consecutive days backwards from the latest row.
model DailyCheckIn {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Stored as the start of that day in UTC. The endpoint normalises now()
  // to UTC midnight before insert so the unique constraint is honest
  // regardless of the user's local timezone.
  date          DateTime
  pointsAwarded Int
  createdAt     DateTime @default(now())

  @@unique([userId, date])
  @@index([userId, date])
}

// -------------------- Coupon claims --------------------
// A user clicks "Save" on a claimable promo code -> a CouponClaim row.
// At checkout, the apply UI lists these so the buyer doesn't need to
// remember the code text. Unique constraint prevents duplicate saves.
model CouponClaim {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  promoCodeId String
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  claimedAt   DateTime @default(now())

  @@unique([userId, promoCodeId])
  @@index([userId, claimedAt])
}
