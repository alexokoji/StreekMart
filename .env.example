DATABASE_URL="file:./dev.db"

# ----------------------- Turso (production DB) -----------------------
# Set in production (Cloud Run, etc.) to route Prisma through the libSQL
# driver adapter. Leave blank in dev — falls back to the SQLite file above.
#
# Get values via:
#   turso db create <db-name>
#   turso db show <db-name>             # → libsql://...turso.io  → TURSO_DATABASE_URL
#   turso db tokens create <db-name>    # → TURSO_AUTH_TOKEN
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""
JWT_SECRET="change-me-in-production-use-a-long-random-string"
NODE_ENV="development"

# Anthropic Claude API — required for the AI Concierge, smart search,
# description/post drafting, outfit pairing, and personalized recs.
# Get a key at https://console.anthropic.com — paste it below.
ANTHROPIC_API_KEY=""

# Optional: override the default Claude model. Defaults to claude-opus-4-7.
# Other supported IDs: claude-sonnet-4-6, claude-haiku-4-5.
# CLAUDE_MODEL="claude-opus-4-7"

# ----------------------- Monnify -----------------------
# Set MONNIFY_LIVE=1 to enable real Monnify calls. With LIVE=0 (default) the
# adapter runs in stub mode: checkouts and disbursements report synthetic
# success so you can develop without real credentials.
MONNIFY_LIVE="0"

# Required when MONNIFY_LIVE=1 — get from the Monnify merchant dashboard.
MONNIFY_API_KEY=""
MONNIFY_SECRET_KEY=""
MONNIFY_CONTRACT_CODE=""
MONNIFY_WALLET_ID=""
MONNIFY_BASE_URL="https://sandbox.monnify.com"
# Webhook signature secret — used to verify TRANSACTION-HASH on inbound events.
MONNIFY_WEBHOOK_HASH=""

# Public origin used to build the Monnify redirectUrl (the page Monnify
# bounces buyers back to after they pay). Set to your deployed origin in
# production. No trailing slash.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ----------------------- Korapay (Primary Payment Gateway) -----------------------
# Korapay is the primary payment gateway; Monnify serves as fallback.
# Set KORAPAY_LIVE=1 to enable real Korapay calls. With LIVE=0 (default) the
# adapter runs in stub mode for development without real credentials.
KORAPAY_LIVE="0"

# Required when KORAPAY_LIVE=1 — get from Korapay merchant dashboard.
# Dashboard → Settings → API Configuration
KORAPAY_PUBLIC_KEY=""           # pk_test_xxx or pk_live_xxx
KORAPAY_SECRET_KEY=""           # sk_test_xxx or sk_live_xxx (also used for webhook signing)
# Optional: Encryption key if Korapay API requires request/response encryption.
# Check Korapay docs to see if your integration requires this.
KORAPAY_ENCRYPTION_KEY=""
KORAPAY_BASE_URL="https://api.korapay.com"

# ----------------------- Jumia Logistics (Shipment & Tracking) -----------------------
# Integration with Jumia Logistics for sellers to create shipments and track deliveries.
# The provider supports real-time tracking updates via webhook.
JUMIA_LOGISTICS_API_KEY=""
JUMIA_LOGISTICS_BASE_URL="https://api.jumia.co.ke/logistics/v1"
# Webhook signature secret — used to verify X-JUMIA-SIGNATURE on inbound tracking updates.
JUMIA_LOGISTICS_WEBHOOK_SECRET=""

# ----------------------- Sendbox Logistics (Shipment & Tracking) -----------------------
# Integration with Sendbox for shipping and delivery tracking.
# Sendbox is a multi-carrier logistics platform supporting multiple couriers.
# Set SENDBOX_LIVE=1 to enable real Sendbox API calls; 0 (default) runs in stub mode.
SENDBOX_LIVE="0"

# Required when SENDBOX_LIVE=1 — get from Sendbox dashboard.
# Staging: sandbox.staging.sendbox.co
# Production: api.sendbox.co
SENDBOX_API_KEY=""
SENDBOX_BASE_URL="https://sandbox.staging.sendbox.co"
# Webhook signature secret — used to verify webhook integrity.
SENDBOX_WEBHOOK_SECRET=""

# ----------------------- Google OAuth -----------------------
# Get from Google Cloud Console → APIs & Services → Credentials →
# OAuth 2.0 Client IDs (Web application).
# Authorized redirect URI: {NEXT_PUBLIC_APP_URL}/api/auth/google/callback
# Leave blank to disable the "Sign in with Google" buttons.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ----------------------- Shipbubble (Logistics) -----------------------
# Pin a real package category_id to skip the runtime lookup. Hit
# GET /api/admin/logistics/shipbubble/categories while signed in as admin to
# list categories your account exposes, then pick one (e.g. "Clothing", "Others").
SHIPBUBBLE_DEFAULT_CATEGORY_ID=""
# Set to "1" once, redeploy, then unset — forces a fresh categories fetch in
# warm processes (useful right after connecting new couriers in Shipbubble).
SHIPBUBBLE_CATEGORY_REFRESH=""

# ----------------------- Google Maps / Places (Checkout Address Picker) -----------------------
# Required to render the map-based address picker in checkout. The same key powers the
# Places Autocomplete predictions and the interactive map preview. Enable the
# "Maps JavaScript API" and "Places API (New)" on the Google Cloud project that owns this
# key, restrict the key to your production domain, and attach a billing account
# ($200/mo free credit is enough for typical e-commerce volumes).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# ----------------------- Sketch Studio -----------------------
# 1 = enables the real Three.js mockup viewer; 0 = falls back to a static
# placeholder. The Three.js bundle is only loaded when this is 1.
FEATURE_SKETCH_3D="1"

# ----------------------- Email (Resend) -----------------------
# 3,000 emails/month free. Sign up at resend.com. When blank, lib/email.ts
# runs in stub mode (logs to stdout). EMAIL_FROM defaults to Resend's shared
# dev address; once you verify a domain, set this to e.g. "StreekMart <hello@yourdomain.com>".
RESEND_API_KEY=""
EMAIL_FROM=""

# ----------------------- Cloudinary (image hosting) -----------------------
# When all three are set, /api/upload pushes to Cloudinary; otherwise it
# falls back to writing public/uploads/ on local disk (dev only).
# Get values from Cloudinary dashboard → Settings → API Keys.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
