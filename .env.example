DATABASE_URL="file:./dev.db"

# ----------------------- Turso (production DB) -----------------------
# Set in production (Cloud Run, etc.) to route Prisma through the libSQL
# driver adapter. Leave blank in dev — falls back to the SQLite file above.
#
# Get values via:
#   turso db create <db-name>
#   turso db show <db-name>             # → libsql://...turso.io  → TURSO_DATABASE_URL
#   turso db tokens create <db-name>    # → TURSO_AUTH_TOKEN
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""
JWT_SECRET="change-me-in-production-use-a-long-random-string"
NODE_ENV="development"

# ----------------------- AI provider -----------------------
# Powers the AI Concierge, smart search, description/post drafting, outfit
# pairing, and personalized recs. Either provider works — src/lib/llm.ts
# picks Gemini first when both are set.
#
# GEMINI_API_KEY — preferred. Free tier ~1,500 req/day on Flash, no card.
#   Get a key at https://aistudio.google.com/apikey
# ANTHROPIC_API_KEY — paid fallback if you'd rather use Claude.
#   Get a key at https://console.anthropic.com
GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""

# Optional model overrides.
# GEMINI_MODEL="gemini-2.0-flash"
# CLAUDE_MODEL="claude-opus-4-7"

# ----------------------- Monnify -----------------------
# Set MONNIFY_LIVE=1 to enable real Monnify calls. With LIVE=0 (default) the
# adapter runs in stub mode: checkouts and disbursements report synthetic
# success so you can develop without real credentials.
MONNIFY_LIVE="0"

# Required when MONNIFY_LIVE=1 — get from the Monnify merchant dashboard.
MONNIFY_API_KEY=""
MONNIFY_SECRET_KEY=""
MONNIFY_CONTRACT_CODE=""
MONNIFY_WALLET_ID=""
MONNIFY_BASE_URL="https://sandbox.monnify.com"
# Webhook signature secret — used to verify TRANSACTION-HASH on inbound events.
MONNIFY_WEBHOOK_HASH=""

# Public origin used to build the Monnify redirectUrl (the page Monnify
# bounces buyers back to after they pay). Set to your deployed origin in
# production. No trailing slash.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ----------------------- Korapay (Primary Payment Gateway) -----------------------
# Korapay is the primary payment gateway; Monnify serves as fallback.
# Set KORAPAY_LIVE=1 to enable real Korapay calls. With LIVE=0 (default) the
# adapter runs in stub mode for development without real credentials.
KORAPAY_LIVE="0"

# Required when KORAPAY_LIVE=1 — get from Korapay merchant dashboard.
# Dashboard → Settings → API Configuration
KORAPAY_PUBLIC_KEY=""           # pk_test_xxx or pk_live_xxx
KORAPAY_SECRET_KEY=""           # sk_test_xxx or sk_live_xxx (also used for webhook signing)
# Optional: Encryption key if Korapay API requires request/response encryption.
# Check Korapay docs to see if your integration requires this.
KORAPAY_ENCRYPTION_KEY=""
KORAPAY_BASE_URL="https://api.korapay.com"

# ----------------------- Jumia Logistics (Shipment & Tracking) -----------------------
# Integration with Jumia Logistics for sellers to create shipments and track deliveries.
# The provider supports real-time tracking updates via webhook.
JUMIA_LOGISTICS_API_KEY=""
JUMIA_LOGISTICS_BASE_URL="https://api.jumia.co.ke/logistics/v1"
# Webhook signature secret — used to verify X-JUMIA-SIGNATURE on inbound tracking updates.
JUMIA_LOGISTICS_WEBHOOK_SECRET=""

# ----------------------- Sendbox Logistics (Shipment & Tracking) -----------------------
# Integration with Sendbox for shipping and delivery tracking.
# Sendbox is a multi-carrier logistics platform supporting multiple couriers.
# Set SENDBOX_LIVE=1 to enable real Sendbox API calls; 0 (default) runs in stub mode.
SENDBOX_LIVE="0"

# Required when SENDBOX_LIVE=1 — get from Sendbox dashboard.
# Staging: sandbox.staging.sendbox.co
# Production: api.sendbox.co
SENDBOX_API_KEY=""
SENDBOX_BASE_URL="https://sandbox.staging.sendbox.co"
# Webhook signature secret — used to verify webhook integrity.
SENDBOX_WEBHOOK_SECRET=""

# ----------------------- Google OAuth -----------------------
# Get from Google Cloud Console → APIs & Services → Credentials →
# OAuth 2.0 Client IDs (Web application).
# Authorized redirect URI: {NEXT_PUBLIC_APP_URL}/api/auth/google/callback
# Leave blank to disable the "Sign in with Google" buttons.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ----------------------- Shipbubble (Logistics) -----------------------
# Pin a real package category_id to skip the runtime lookup. Hit
# GET /api/admin/logistics/shipbubble/categories while signed in as admin to
# list categories your account exposes, then pick one (e.g. "Clothing", "Others").
SHIPBUBBLE_DEFAULT_CATEGORY_ID=""
# Set to "1" once, redeploy, then unset — forces a fresh categories fetch in
# warm processes (useful right after connecting new couriers in Shipbubble).
SHIPBUBBLE_CATEGORY_REFRESH=""

# ----------------------- Google Maps / Places (Checkout Address Picker) -----------------------
# Required to render the map-based address picker in checkout. The same key powers the
# Places Autocomplete predictions and the interactive map preview. Enable the
# "Maps JavaScript API" and "Places API (New)" on the Google Cloud project that owns this
# key, restrict the key to your production domain, and attach a billing account
# ($200/mo free credit is enough for typical e-commerce volumes).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# ----------------------- Sketch Studio -----------------------
# 1 = enables the real Three.js mockup viewer; 0 = falls back to a static
# placeholder. The Three.js bundle is only loaded when this is 1.
FEATURE_SKETCH_3D="1"

# ----------------------- Email (Resend) -----------------------
# 3,000 emails/month free. Sign up at resend.com.
#
# Without RESEND_API_KEY the email layer runs in STUB MODE — `sendEmail`
# returns ok=true but only logs to stdout. Look for `[email:stub]` in the
# Vercel logs to confirm; if you see that, no emails are being delivered.
#
# To enable real sending in production:
#   1. Create a Resend API key (Production scope) and add it as
#      `RESEND_API_KEY` in your Vercel project env vars (Production scope).
#   2. Verify a sending domain on resend.com → Domains and set
#      `EMAIL_FROM` to e.g. "StreekMart <hello@yourdomain.com>".
#      Without a verified domain, Resend restricts the default
#      `onboarding@resend.dev` address to your own account email — most
#      recipients won't get mail.
#   3. Trigger a deploy. Verify with the admin diagnostic endpoint:
#        curl -X POST https://<host>/api/admin/email/test \
#          -b "<admin session cookie>" \
#          -H 'Content-Type: application/json' \
#          -d '{"to":"you@example.com"}'
#      Response includes the live SendResult so you can see Resend's error
#      verbatim if anything's wrong.
#
# Failure logs to grep in Vercel: `[email:send]`, `[email:stub]`.
RESEND_API_KEY=""
EMAIL_FROM=""

# ----------------------- Cloudinary (image hosting) -----------------------
# When all three are set, /api/upload pushes to Cloudinary; otherwise it
# falls back to writing public/uploads/ on local disk (dev only).
# Get values from Cloudinary dashboard → Settings → API Keys.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""


# ----------------------- WhatsApp Cloud API -----------------------
# Powers /api/whatsapp/webhook — buyers DM StreekMart's WhatsApp Business
# number and chat with the same AI concierge that runs the on-site
# SmartSearch panel. The AI searches the live catalog and replies with
# product links that WhatsApp auto-previews as cards.
#
# When any of these are blank the webhook degrades gracefully: it logs to
# stdout and tells the buyer the bot is offline. The /api/ai/concierge
# on-site path is unaffected.
#
# Setup (Meta WhatsApp Business Platform — Cloud API):
#   1. developers.facebook.com → create / pick an app → Add WhatsApp.
#   2. Accept the terms; Meta gives you a test phone number.
#   3. From the WhatsApp → API Setup screen, copy:
#        - Phone number ID            → WHATSAPP_PHONE_NUMBER_ID
#        - Temporary access token     → WHATSAPP_ACCESS_TOKEN (rotate to
#          a permanent system-user token before going live)
#   4. Pick a random string and paste it as WHATSAPP_VERIFY_TOKEN below.
#      Then in Meta's "Configure webhooks" page set:
#        Callback URL    = https://streekmart.online/api/whatsapp/webhook
#        Verify token    = (the same string)
#      Click "Verify and save". Meta hits the webhook with a GET; our
#      handler returns hub.challenge when the tokens match.
#   5. Subscribe to the "messages" webhook field.
#   6. App settings → Basic → "App secret" → reveal and paste it as
#      WHATSAPP_APP_SECRET. The webhook verifies HMAC-SHA256 signatures
#      on every inbound; without it dev mode accepts everything.
#
# Cost: user-initiated conversations (the buyer DMs first — that's our
# entire flow) are free in unlimited volume on the 24-hour service window.
# Only business-initiated marketing templates count toward the 1k/month
# free allowance.
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""


# ----------------------- Meta: User Data Deletion -----------------------
# Required by Meta for any app handling user data. Pick one of the two
# options in your app dashboard:
#
#   Settings -> Basic -> User Data Deletion -> "Data Deletion Instructions URL"
#     ^ recommended. A public page with human-readable instructions.
#       Paste: https://streekmart.online/data-deletion
#
#   Settings -> Basic -> User Data Deletion -> "Data Deletion Callback URL"
#     ^ programmatic. Server endpoint Meta hits when a user removes our
#       app from Facebook / WhatsApp. Already built at
#       https://streekmart.online/api/meta/data-deletion (signature-
#       verified via WHATSAPP_APP_SECRET above).
#
# The Instructions URL page (/data-deletion) is auth-aware:
#   - signed-in users see a "retype your email" self-serve form that
#     wipes the account on the spot via /api/account/deletion-request.
#   - signed-out users get a mailto: to support@streekmart.online + a
#     sign-in CTA.
# No env var to set here.
